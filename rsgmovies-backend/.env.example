# ==============================================================================
# RSG Movies Backend - Environment Configuration Example
# Copy this file to .env and provide appropriate production/environment secrets.
# NEVER commit .env or secrets to public version control.
# ==============================================================================

# Django Core
SECRET_KEY=your-secure-random-django-secret-key-at-least-50-characters
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,rsgmovies.vercel.app,rsg-movies.vercel.app

# Database Configuration (Neon PostgreSQL in production / SQLite for dev)
DATABASE_URL=postgresql://username:password@hostname:5432/dbname?channel_binding=require&sslmode=require

# Microsoft Entra ID (OpenID Connect)
ENTRA_CLIENT_ID=your-entra-client-id
ENTRA_CLIENT_SECRET=your-entra-client-secret
ENTRA_TENANT_ID=your-entra-tenant-id
OIDC_RP_SCOPES=openid profile email
LOGIN_REDIRECT_URL=https://rsgmovies.vercel.app/
LOGOUT_REDIRECT_URL=https://rsgmovies.vercel.app/login

# Movie Blast API Configuration
MOVIE_BLAST_DOMAIN=https://app.cloud-mb.xyz
MOVIE_BLAST_TOKEN=your-movie-blast-token
MOVIE_BLAST_KEY=your-movie-blast-key
MOVIE_BLAST_SECRET_KEY=your-movie-blast-secret-key

# Scraper Domains
MOVIERULZ_DOMAIN=https://www.5movierulz.army/
TAMILMV_DOMAIN=https://www.1tamilmv.com/
IBOMMA_DOMAIN=https://rto.bappam.eu/telugu-movies/
ALL_MOVIES_DOMAIN=https://123multihub.one/
TORRENT_SEARCH_DOMAIN=https://torrentz2.nz/search

# YouTube / Media Downloader API
YOUTUBE_DOWNLOADER_API_URL=https://p.oceansaver.in/
YOUTUBE_DOWNLOADER_API_KEY=your-api-key

# Seedr Credential Encryption at Rest (32-byte URL-safe base64 string)
SEEDR_ENCRYPTION_KEY=your-32-byte-base64-fernet-encryption-key

# Allowed CORS & CSRF Origins (Strictly restricted to localhost & official production domains)
CORS_ALLOWED_ORIGINS=https://rsgmovies.vercel.app,https://rsg-movies.vercel.app,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=https://rsgmovies.vercel.app,https://rsg-movies.vercel.app,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# Cookie & Session Security (Lax for same-origin proxy and local Vite proxy)
SESSION_COOKIE_AGE=3600
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SECURE=True

# Rate Limiting Throttles
THROTTLE_RATE_ANON=120/minute
THROTTLE_RATE_USER=1200/minute

# Logging
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=WARNING
