<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:paddingStart="24dp"
    android:paddingEnd="16dp"
    android:paddingTop="20dp">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header Row: Title & Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tv_files_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📁 Seedr Cloud Storage"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_white" />

                <Button
                    android:id="@+id/btn_files_refresh"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/btn_secondary_selector"
                    android:text="🔄  Refresh"
                    android:textColor="@color/text_white"
                    android:textSize="11sp"
                    android:paddingHorizontal="14dp"
                    android:layout_marginEnd="10dp"
                    android:focusable="true" />

                <Button
                    android:id="@+id/btn_files_add_torrent"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/btn_primary_selector"
                    android:text="➕  Add Torrent"
                    android:textColor="@color/text_white"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:paddingHorizontal="16dp"
                    android:focusable="true" />
            </LinearLayout>

            <!-- Storage Capacity Meter Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="10dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/surface_card"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Cloud Storage Usage"
                            android:textColor="@color/text_white"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_storage_usage_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 MB / 2.0 GB Used"
                            android:textColor="@color/text_accent"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/pb_storage_meter"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:progress="0"
                        android:max="100"
                        android:progressTint="@color/primary_light"
                        android:progressBackgroundTint="@color/surface_elevated" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Root Folders Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Folders"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_files_folders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginBottom="20dp" />

            <!-- Empty State -->
            <TextView
                android:id="@+id/tv_files_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No torrent folders found in your Seedr cloud."
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:gravity="center"
                android:padding="30dp"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Loading Indicator -->
    <ProgressBar
        android:id="@+id/pb_files_loading"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/primary_light"
        android:visibility="visible" />

</FrameLayout>
