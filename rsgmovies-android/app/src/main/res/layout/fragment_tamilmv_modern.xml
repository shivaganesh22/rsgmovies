<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="20dp">

    <!-- Header: Clean Title & Search Filter -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="TamilMV"
            android:textColor="@color/text_white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Search input -->
        <EditText
            android:id="@+id/et_tamilmv_search"
            android:layout_width="220dp"
            android:layout_height="36dp"
            android:background="@drawable/nav_item_selector"
            android:hint="Filter releases..."
            android:textColorHint="@color/text_muted"
            android:textColor="@color/text_white"
            android:textSize="12sp"
            android:paddingHorizontal="14dp"
            android:singleLine="true"
            android:imeOptions="actionDone"
            android:focusable="true" />
    </LinearLayout>

    <!-- Language Filter Pills Bar -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_tamilmv_languages"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="14dp" />

    <!-- Content / Releases Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_tamilmv_items"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="40dp" />

        <ProgressBar
            android:id="@+id/pb_tamilmv_loading"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/primary_light"
            android:visibility="visible" />

        <TextView
            android:id="@+id/tv_tamilmv_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="No releases found"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
