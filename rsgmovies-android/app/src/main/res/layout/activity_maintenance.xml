<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/background"
    android:padding="36dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🛠️"
        android:textSize="64sp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tv_maintenance_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="System Maintenance"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/text_white"
        android:gravity="center" />

    <TextView
        android:id="@+id/tv_maintenance_message"
        android:layout_width="540dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="RSG Movies is currently undergoing scheduled maintenance. Please check back shortly."
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:gravity="center"
        android:lineSpacingExtra="4dp" />

    <Button
        android:id="@+id/btn_maintenance_retry"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/btn_primary_selector"
        android:text="Check Again"
        android:textColor="@color/text_white"
        android:textStyle="bold"
        android:paddingHorizontal="32dp"
        android:focusable="true" />

</LinearLayout>
