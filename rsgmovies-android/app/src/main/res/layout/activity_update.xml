<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/background"
    android:padding="36dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🚀"
        android:textSize="64sp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tv_update_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Update Required"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/text_white"
        android:gravity="center" />

    <TextView
        android:id="@+id/tv_update_message"
        android:layout_width="540dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="A new version of RSG Movies TV is required to continue streaming."
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:gravity="center" />

    <!-- Release Notes Box -->
    <LinearLayout
        android:id="@+id/ll_release_notes"
        android:layout_width="540dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/media_card_focus_bg"
        android:padding="16dp"
        android:layout_marginTop="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="What's New:"
            android:textColor="@color/text_accent"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tv_release_notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bug fixes and performance improvements."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="24dp"
        android:gravity="center">

        <Button
            android:id="@+id/btn_download_update"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/btn_primary_selector"
            android:text="Download Update"
            android:textColor="@color/text_white"
            android:textStyle="bold"
            android:paddingHorizontal="32dp"
            android:focusable="true" />

        <Button
            android:id="@+id/btn_skip_update"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/btn_secondary_selector"
            android:text="Skip for Now"
            android:textColor="@color/text_white"
            android:textStyle="bold"
            android:paddingHorizontal="24dp"
            android:visibility="gone"
            android:focusable="true" />
    </LinearLayout>

</LinearLayout>
