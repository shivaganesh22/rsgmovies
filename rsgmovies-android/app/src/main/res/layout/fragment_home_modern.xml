<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsv_home"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hero Spotlight Banner -->
            <include
                android:id="@+id/hero_banner"
                layout="@layout/item_hero_banner"
                android:visibility="gone" />

            <!-- Category Rows RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_home_sections"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:nestedScrollingEnabled="false" />

            <!-- Extra bottom padding for TV overscan -->
            <View
                android:layout_width="match_parent"
                android:layout_height="60dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Loading Indicator -->
    <ProgressBar
        android:id="@+id/pb_home_loading"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/primary_light"
        android:visibility="visible" />

    <!-- Error State -->
    <LinearLayout
        android:id="@+id/ll_home_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_home_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Could not load media catalog."
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btn_home_retry"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/btn_primary_selector"
            android:paddingHorizontal="24dp"
            android:text="Retry"
            android:textColor="@color/text_white"
            android:focusable="true" />
    </LinearLayout>

</FrameLayout>
